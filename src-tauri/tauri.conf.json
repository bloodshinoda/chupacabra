{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Chupacabra System",
  "version": "0.3.1",
  "identifier": "com.chupacabra.system",
  "build": {
    "beforeDevCommand": "npm run dev -- --host 127.0.0.1 --port 5173 --strictPort",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build:desktop",
    "frontendDist": "../.output/public"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Chupacabra System",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true,
        "visible": false
      },
      {
        "label": "splashscreen",
        "url": "/splashscreen.html",
        "width": 480,
        "height": 480,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "closable": false,
        "minimizable": false,
        "maximizable": false,
        "center": true,
        "focus": false,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
